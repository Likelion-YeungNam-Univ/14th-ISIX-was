# 이 파일을 복사해 사용합니다.
#   로컬 : 프로젝트 루트에 .env
#   EC2  : /home/ubuntu/.env  (systemd 가 EnvironmentFile 로 읽습니다)
#
# prod 프로필에서는 DB_URL 이 필수입니다. 비어 있으면 애플리케이션이
# 기동에 실패합니다. 조용히 잘못된 DB 로 뜨는 것을 막기 위한 의도입니다.

# 데이터베이스
# 로컬은 docker compose up -d 로 띄운 컨테이너를 그대로 씁니다.
DB_URL=jdbc:postgresql://localhost:5432/closr
DB_USERNAME=closr
DB_PASSWORD=closr1234

# AI 서버 — 아바타 생성은 비동기(폴링)라 개별 호출은 짧습니다.
# 사진 업로드(최대 10MB) 때문에 기본값보다만 여유를 둡니다.
AI_SERVER_URL=http://localhost:8000
AI_SERVER_TIMEOUT=30000

# 스토리지 (Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
