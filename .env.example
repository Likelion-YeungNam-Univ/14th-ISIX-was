# 이 파일을 복사해 사용합니다.
#   로컬 : 프로젝트 루트에 .env
#   EC2  : /home/ubuntu/.env  (systemd 가 EnvironmentFile 로 읽습니다)
#
# prod 프로필에서는 DB_URL 이 필수입니다. 비어 있으면 애플리케이션이
# 기동에 실패합니다. 조용히 인메모리 H2 로 뜨는 것을 막기 위한 의도입니다.
# PostgreSQL 이 아직 없다면 아래 H2 값을 명시적으로 넣어두세요.

# 데이터베이스 (배포 시 Render PostgreSQL)
DB_URL=jdbc:h2:mem:closr
DB_USERNAME=sa
DB_PASSWORD=

# JWT — openssl rand -base64 32 로 생성
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# AI 서버 — 아바타 생성은 비동기(폴링)라 개별 호출은 짧습니다.
# 사진 업로드(최대 10MB) 때문에 기본값보다만 여유를 둡니다.
AI_SERVER_URL=http://localhost:8000
AI_SERVER_TIMEOUT=30000

# 소셜 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# 스토리지 (Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
