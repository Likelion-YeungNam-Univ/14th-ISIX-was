# 데이터베이스 (배포 시 Render PostgreSQL)
DB_URL=jdbc:h2:mem:closer
DB_USERNAME=sa
DB_PASSWORD=

# JWT — openssl rand -base64 32 로 생성
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# AI 서버 — 아바타 생성이 최대 30초라 타임아웃을 넉넉히
AI_SERVER_URL=http://localhost:8000
AI_SERVER_TIMEOUT=60000

# 소셜 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# 스토리지 (Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
